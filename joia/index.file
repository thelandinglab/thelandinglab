<script>
(function(){
  const WA = '5511983305364';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const root = document.documentElement;

  /* WhatsApp: window.location.href */
  document.querySelectorAll('[data-wa]').forEach(a => {
    const url = 'https://wa.me/' + WA + '?text=' + encodeURIComponent(a.dataset.wa);
    a.href = url;
    a.addEventListener('click', e => { e.preventDefault(); window.location.href = url; });
  });

  /* split headline per char, words kept whole */
  const h = document.getElementById('heroTitle');
  let i = 0;
  h.querySelectorAll('.line').forEach(line => {
    const words = line.textContent.trim().split(/\s+/);
    line.innerHTML = words.map(w => '<span class="w">' + [...w].map(ch => '<span class="c" style="--i:' + (i++) + '">' + ch + '</span>').join('') + '</span>').join(' ');
  });
  requestAnimationFrame(() => { document.body.classList.add('loaded'); setTimeout(() => h.classList.add('in'), 60); });

  /* nav + progress + float */
  const nav = document.getElementById('nav'), prog = document.getElementById('progress'), wf = document.getElementById('waFloat');
  const onScroll = () => {
    const y = scrollY, max = document.body.scrollHeight - innerHeight;
    nav.classList.toggle('scrolled', y > 30);
    prog.style.transform = 'scaleX(' + (max > 0 ? y / max : 0) + ')';
    wf.classList.toggle('show', y > innerHeight * .6);
  };
  addEventListener('scroll', onScroll, {passive:true}); onScroll();

  const tg = document.getElementById('navToggle'), links = document.getElementById('navLinks');
  tg.addEventListener('click', () => { tg.classList.toggle('open'); links.classList.toggle('open'); document.body.style.overflow = links.classList.contains('open') ? 'hidden' : ''; });
  links.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { tg.classList.remove('open'); links.classList.remove('open'); document.body.style.overflow=''; }));

  const anchors = links.querySelectorAll('a');
  const secObs = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { anchors.forEach(a => a.classList.toggle('active', a.getAttribute('href') === '#' + e.target.id)); }
  }), {rootMargin:'-45% 0px -45% 0px'});
  document.querySelectorAll('section[id]').forEach(s => secObs.observe(s));

  /* reveal + dividers */
  const io = new IntersectionObserver(es => es.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add(e.target.hasAttribute('data-draw') ? 'drawn' : 'in'); io.unobserve(e.target); }
  }), {threshold:.14, rootMargin:'0px 0px -6% 0px'});
  document.querySelectorAll('.reveal,[data-draw]').forEach(el => io.observe(el));

  /* card shine */
  document.querySelectorAll('.shine').forEach(el => el.addEventListener('pointermove', e => {
    const r = el.getBoundingClientRect();
    el.style.setProperty('--x', (e.clientX - r.left) + 'px');
    el.style.setProperty('--y', (e.clientY - r.top) + 'px');
  }));

  /* cursor + hero parallax (desktop only) */
  if (fine && !reduce) {
    const dot = document.getElementById('cDot'), ring = document.getElementById('cRing');
    let mx = innerWidth/2, my = innerHeight/2, rx = mx, ry = my;
    addEventListener('pointermove', e => {
      mx = e.clientX; my = e.clientY;
      document.body.classList.add('cursor-on');
      dot.style.transform = 'translate3d(' + mx + 'px,' + my + 'px,0)';
      root.style.setProperty('--mx', (mx / innerWidth - .5).toFixed(3));
      root.style.setProperty('--my', (my / innerHeight - .5).toFixed(3));
    });
    document.addEventListener('mouseleave', () => document.body.classList.remove('cursor-on'));
    (function loop(){ rx += (mx - rx) * .16; ry += (my - ry) * .16; ring.style.transform = 'translate3d(' + rx + 'px,' + ry + 'px,0)'; requestAnimationFrame(loop); })();
    document.querySelectorAll('a,button,.g-item').forEach(el => {
      el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
      el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
    });
  }

  /* lightbox */
  const items = [...document.querySelectorAll('.g-item img')];
  const lb = document.getElementById('lb'), lbImg = document.getElementById('lbImg'), lbCount = document.getElementById('lbCount');
  let cur = 0;
  const show = n => { cur = (n + items.length) % items.length; lbImg.src = items[cur].src; lbCount.textContent = String(cur+1).padStart(2,'0') + ' / ' + String(items.length).padStart(2,'0'); };
  const open = n => { show(n); lb.classList.add('open'); document.body.style.overflow = 'hidden'; };
  const close = () => { lb.classList.remove('open'); document.body.style.overflow = ''; };
  document.querySelectorAll('.g-item').forEach((el, n) => el.addEventListener('click', () => open(n)));
  document.getElementById('lbClose').onclick = close;
  document.getElementById('lbPrev').onclick = e => { e.stopPropagation(); show(cur - 1); };
  document.getElementById('lbNext').onclick = e => { e.stopPropagation(); show(cur + 1); };
  lb.addEventListener('click', e => { if (e.target === lb) close(); });
  addEventListener('keydown', e => {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') close(); if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1);
  });
  let sx = null;
  lb.addEventListener('touchstart', e => sx = e.touches[0].clientX, {passive:true});
  lb.addEventListener('touchend', e => { if (sx === null) return; const dx = e.changedTouches[0].clientX - sx; if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1)); sx = null; });
})();
</script>
</body>
</html>
