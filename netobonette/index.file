<!DOCTYPE html>
<!-- Neto Bonette · v1 · adaptado do template Realeza (paleta Vaticano) -->
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#f6c90e">
  <meta name="description" content="Neto Bonette — católico, coroinha, criador de conteúdo e voluntário da Pastoral da Criança.">
  <title>Neto Bonette</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
  :root{
    --white:#ffffff;--paper:#fffbea;
    --yellow:#f6c90e;--yellow-soft:#fde98a;
    --gold:#8a6a00;--gold-line:rgba(138,106,0,.28);
    --ink:#2b2114;--ink-mute:#6b604e;
    --red:#a31d24;--blue:#4f86b8;
    --line:rgba(43,33,20,.12);
    --font-display:"Cormorant Garamond",Georgia,serif;
    --font-body:"Jost",system-ui,sans-serif;
    --ease:cubic-bezier(.16,1,.3,1);
    --pad-sec:clamp(64px,10vw,120px);--container:1100px;--radius:10px;
    --diamond:conic-gradient(from 45deg at 50% 50%,var(--yellow) 0 25%,var(--white) 0 50%,var(--yellow) 0 75%,var(--white) 0);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
  body{background:var(--white);color:var(--ink);font-family:var(--font-body);line-height:1.6;overflow-x:hidden;-webkit-font-smoothing:antialiased}
  a{color:inherit;text-decoration:none}img{display:block;max-width:100%}
  a:focus-visible,button:focus-visible{outline:2px solid var(--red);outline-offset:3px}
  ::selection{background:var(--yellow);color:var(--ink)}
  .container{width:100%;max-width:var(--container);margin:0 auto;padding:0 clamp(16px,5vw,40px)}

  .scroll-progress{position:fixed;top:0;left:0;height:3px;width:100%;z-index:200;transform-origin:0 50%;transform:scaleX(var(--p,0));background:var(--yellow);pointer-events:none}

  /* NAV */
  .nav-wrap{position:fixed;top:0;left:0;width:100%;z-index:120;padding-top:env(safe-area-inset-top);transition:background .4s var(--ease),border-color .4s var(--ease);border-bottom:1px solid transparent}
  .nav-wrap.scrolled{background:rgba(255,255,255,.86);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom-color:var(--line)}
  .navbar{display:flex;align-items:center;justify-content:space-between;height:70px;max-width:var(--container);margin:0 auto;padding:0 clamp(16px,5vw,40px)}
  .brand{display:flex;align-items:center;gap:11px}
  .brand-mark{width:42px;height:42px;border-radius:50%;overflow:hidden;flex:0 0 auto;border:2px solid var(--yellow);background:var(--yellow)}
  .brand-mark img{width:100%;height:100%;object-fit:cover}
  .brand-text{display:flex;flex-direction:column;line-height:1.05}
  .brand-name{font-family:var(--font-display);font-weight:700;font-size:1.35rem}
  .brand-sub{font-size:.72rem;color:var(--ink-mute)}
  .nav-links{display:flex;gap:28px;list-style:none}
  .nav-links a{font-size:.9rem;color:var(--ink-mute);padding:6px 0;position:relative;transition:color .3s}
  .nav-links a::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--yellow);transition:width .35s var(--ease)}
  .nav-links a:hover{color:var(--ink)}.nav-links a:hover::after{width:100%}
  .mobile-toggle{display:none;background:none;border:0;cursor:pointer;width:44px;height:44px;align-items:center;justify-content:center}
  .bars{display:flex;flex-direction:column;gap:5px}
  .bars span{width:24px;height:2px;background:var(--ink);border-radius:2px;transition:transform .35s var(--ease),opacity .25s}
  body.menu-open .bars span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  body.menu-open .bars span:nth-child(2){opacity:0}
  body.menu-open .bars span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
  .mobile-menu{position:fixed;inset:0;z-index:110;background:rgba(255,255,255,.98);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;opacity:0;visibility:hidden;transition:opacity .4s var(--ease),visibility .4s}
  body.menu-open .mobile-menu{opacity:1;visibility:visible}
  .mobile-menu a{font-family:var(--font-display);font-size:2.2rem;font-weight:600}
  .mobile-menu .mm-cta{margin-top:20px;font-family:var(--font-body);font-size:.95rem;font-weight:600;background:var(--yellow);padding:14px 30px;border-radius:999px}

  /* HERO */
  .hero{position:relative;min-height:100svh;display:grid;place-items:center;text-align:center;overflow:hidden;isolation:isolate;padding:110px 16px 60px}
  .hero-field{position:absolute;inset:0;z-index:-1;background:var(--diamond);background-size:120px 120px;opacity:.55;
    -webkit-mask-image:radial-gradient(70% 60% at 50% 42%,#000 20%,transparent 75%);mask-image:radial-gradient(70% 60% at 50% 42%,#000 20%,transparent 75%)}
  .hero-inner{max-width:720px}
  .portrait{position:relative;width:clamp(190px,52vw,270px);aspect-ratio:1;margin:0 auto 28px;border-radius:50%;padding:7px;background:var(--white);box-shadow:0 0 0 2px var(--gold-line),0 24px 60px -24px rgba(138,106,0,.55);
    opacity:0;transform:scale(.92);animation:popIn 1s var(--ease) .1s forwards}
  .portrait img{width:100%;height:100%;border-radius:50%;object-fit:cover}
  .portrait-cross{position:absolute;right:4%;bottom:6%;width:46px;height:46px;border-radius:50%;background:var(--red);display:grid;place-items:center;box-shadow:0 6px 16px rgba(163,29,36,.35)}
  .portrait-cross svg{width:20px;height:20px;stroke:#fff;fill:none}
  @keyframes popIn{to{opacity:1;transform:none}}
  .hero-tag{font-size:.95rem;color:var(--gold);font-weight:500;margin-bottom:8px;opacity:0;animation:fadeUp .8s var(--ease) .35s forwards}
  .hero-title{font-family:var(--font-display);font-weight:700;font-size:clamp(3.2rem,13vw,6.6rem);line-height:.95;letter-spacing:-.01em}
  .char{display:inline-block;transform:translateY(105%);opacity:0}
  .char.in{animation:charIn .7s var(--ease) forwards;animation-delay:var(--cd,0ms)}
  @keyframes charIn{to{transform:none;opacity:1}}
  .hero-desc{margin:20px auto 0;max-width:40ch;color:var(--ink-mute);font-size:1.08rem;opacity:0;animation:fadeUp .8s var(--ease) .8s forwards}
  .hero-actions{margin-top:30px;display:flex;justify-content:center;gap:12px;flex-wrap:wrap;opacity:0;animation:fadeUp .8s var(--ease) .95s forwards}
  @keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .scroll-cue{position:absolute;bottom:calc(22px + env(safe-area-inset-bottom));left:50%;width:22px;height:36px;margin-left:-11px;border:2px solid var(--gold-line);border-radius:12px}
  .scroll-cue::after{content:"";position:absolute;left:50%;top:7px;width:4px;height:7px;margin-left:-2px;border-radius:2px;background:var(--gold);animation:cue 1.8s ease-in-out infinite}
  @keyframes cue{0%{opacity:0;transform:translateY(0)}40%{opacity:1}100%{opacity:0;transform:translateY(12px)}}

  /* BUTTONS */
  .btn{display:inline-flex;align-items:center;gap:9px;font-size:.95rem;font-weight:600;padding:14px 26px;border-radius:999px;position:relative;overflow:hidden;transition:transform .3s var(--ease),box-shadow .3s var(--ease)}
  .btn svg{width:19px;height:19px;flex:0 0 auto}
  .btn-main{background:var(--yellow);color:var(--ink);box-shadow:0 10px 26px -10px rgba(246,201,14,.9)}
  .btn-main:hover{transform:translateY(-3px)}
  .btn-main::after{content:"";position:absolute;top:0;left:-120%;width:55%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.7),transparent);transform:skewX(-20deg);animation:shimmer 4.5s ease-in-out 2s infinite}
  @keyframes shimmer{0%,70%{left:-120%}100%{left:150%}}
  .btn-ghost{border:1.5px solid var(--ink);color:var(--ink);background:var(--white)}
  .btn-ghost:hover{background:var(--ink);color:var(--white);transform:translateY(-3px)}

  /* MARQUEE */
  .marquee{background:var(--yellow);overflow:hidden;padding:16px 0;border-block:1px solid var(--gold-line)}
  .marquee-track{display:flex;width:max-content;animation:scroll 30s linear infinite}
  .marquee-item{font-family:var(--font-display);font-style:italic;font-weight:600;font-size:1.35rem;color:var(--ink);padding:0 26px;white-space:nowrap;display:flex;align-items:center;gap:26px}
  .marquee-item::after{content:"✠";color:var(--red);font-style:normal;font-size:1rem}
  @keyframes scroll{to{transform:translateX(-50%)}}

  /* SECTIONS */
  .sec{padding:var(--pad-sec) 0}
  .sec--paper{background:var(--paper)}
  .sec-title{font-family:var(--font-display);font-weight:700;font-size:clamp(2.2rem,7vw,3.4rem);line-height:1.05;max-width:18ch}
  .sec-desc{margin-top:14px;max-width:52ch;color:var(--ink-mute);font-size:1.05rem}
  .center{text-align:center}.center .sec-title,.center .sec-desc{margin-left:auto;margin-right:auto}
  .reveal{opacity:0;transform:translateY(22px);transition:opacity .8s var(--ease),transform .8s var(--ease);transition-delay:calc(var(--i,0)*90ms)}
  .reveal.in-view{opacity:1;transform:none}

  /* separador temático: cruz entre linhas */
  .sep{display:flex;align-items:center;justify-content:center;gap:16px;padding:6px 0}
  .sep span{height:1px;width:0;background:var(--gold-line);transition:width 1s var(--ease)}
  .sep svg{width:22px;height:22px;stroke:var(--gold);fill:none;opacity:0;transform:rotate(-90deg);transition:opacity .6s .3s,transform .9s var(--ease) .3s}
  .sep.in-view span{width:min(110px,26vw)}.sep.in-view svg{opacity:1;transform:none}

  /* MISSÕES */
  .missoes{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .missao{background:var(--white);border:1px solid var(--line);border-radius:var(--radius);padding:30px 26px;position:relative;overflow:hidden}
  .missao::before{content:"";position:absolute;left:0;top:0;height:4px;width:100%;background:var(--c,var(--yellow))}
  .missao-icon{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--c,var(--yellow)) 16%,#fff);margin-bottom:18px}
  .missao-icon svg{width:26px;height:26px;stroke:var(--c2,var(--gold));fill:none}
  .missao h3{font-family:var(--font-display);font-weight:700;font-size:1.7rem;line-height:1.1}
  .missao p{margin-top:8px;color:var(--ink-mute)}

  /* GALERIA */
  .galeria{margin-top:44px;display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;align-items:start}
  .g-item{border-radius:var(--radius);overflow:hidden;background:var(--paper);cursor:zoom-in;border:1px solid var(--line);padding:0}
  .g-item img{width:100%;height:auto;transition:transform .6s var(--ease)}
  .g-item:hover img{transform:scale(1.03)}
  .lightbox{position:fixed;inset:0;z-index:300;background:rgba(20,16,10,.92);display:flex;align-items:center;justify-content:center;padding:20px;opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}
  .lightbox.open{opacity:1;visibility:visible}
  .lightbox img{max-width:100%;max-height:88vh;border-radius:8px;object-fit:contain}
  .lb-close{position:absolute;top:calc(14px + env(safe-area-inset-top));right:14px;width:46px;height:46px;border-radius:50%;border:0;background:var(--yellow);font-size:1.5rem;cursor:pointer;color:var(--ink)}

  /* REDES */
  .redes{margin-top:44px;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .rede{display:flex;flex-direction:column;gap:6px;padding:26px;border-radius:var(--radius);background:var(--white);border:1px solid var(--line);transition:transform .35s var(--ease),border-color .35s}
  .rede:hover{transform:translateY(-4px);border-color:var(--yellow)}
  .rede-top{display:flex;align-items:center;gap:12px}
  .rede-top svg{width:30px;height:30px}
  .rede-name{font-family:var(--font-display);font-weight:700;font-size:1.5rem}
  .rede-handle{color:var(--gold);font-weight:500}
  .rede-stats{display:flex;gap:22px;margin-top:10px;padding-top:12px;border-top:1px solid var(--line)}
  .rede-stats b{display:block;font-family:var(--font-display);font-size:1.7rem;line-height:1}
  .rede-stats small{color:var(--ink-mute);font-size:.85rem}

  /* CONTATO */
  .contato{position:relative;overflow:hidden;isolation:isolate}
  .contato::before{content:"";position:absolute;inset:0;z-index:-1;background:var(--diamond);background-size:90px 90px;opacity:.35}
  .contato-card{max-width:640px;margin:0 auto;background:var(--white);border-radius:18px;padding:clamp(32px,6vw,54px) clamp(22px,5vw,48px);text-align:center;box-shadow:0 30px 70px -30px rgba(138,106,0,.45);border:1px solid var(--gold-line)}
  .contato-actions{margin-top:26px;display:flex;flex-direction:column;gap:12px;align-items:stretch}
  .contato-actions .btn{justify-content:center}
  .mail{margin-top:18px;color:var(--ink-mute);font-size:.95rem;word-break:break-all}
  .mail a{color:var(--gold);font-weight:500}

  /* FOOTER */
  .footer{padding:44px 0 calc(34px + env(safe-area-inset-bottom));border-top:1px solid var(--line);text-align:center}
  .footer .brand{justify-content:center}
  .footer-socials{display:flex;justify-content:center;gap:12px;margin:20px 0}
  .footer-social{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;color:var(--ink-mute);transition:border-color .3s,color .3s}
  .footer-social:hover{border-color:var(--yellow);color:var(--ink)}
  .footer-social svg{width:19px;height:19px}
  .footer small{color:var(--ink-mute);font-size:.82rem}

  .floating-wa{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom));z-index:100;width:56px;height:56px;border-radius:50%;background:var(--yellow);color:var(--ink);display:grid;place-items:center;box-shadow:0 10px 26px rgba(138,106,0,.35);transition:transform .3s var(--ease)}
  .floating-wa:hover{transform:scale(1.08)}.floating-wa svg{width:27px;height:27px}

  @media(max-width:900px){
    .missoes,.redes{grid-template-columns:1fr}
    .galeria{grid-template-columns:1fr 1fr}
    .galeria .g-item:first-child{grid-row:span 2}
  }
  @media(max-width:760px){.nav-links{display:none}.mobile-toggle{display:flex}}
  @media(max-width:480px){.hero-actions .btn{width:100%;justify-content:center}}
  @media(prefers-reduced-motion:reduce){
    *{animation-duration:.001ms !important;animation-iteration-count:1 !important;transition-duration:.001ms !important}
    .char{transform:none;opacity:1}.reveal{opacity:1;transform:none}.marquee-track{animation:none}
  }
  </style>
</head>
<body>
  <div class="scroll-progress" aria-hidden="true"></div>

  <div class="nav-wrap" id="navWrap">
    <nav class="navbar" aria-label="Principal">
      <a href="#inicio" class="brand" aria-label="Neto Bonette">
        <span class="brand-mark"><img src="data:image/jpeg;base64," alt=""></span>
        <span class="brand-text"><span class="brand-name">Neto Bonette</span><span class="brand-sub">Católico &amp; Coroinha</span></span>
      </a>
      <ul class="nav-links">
        <li><a href="#missoes">Quem sou</a></li>
        <li><a href="#galeria">Fotos</a></li>
        <li><a href="#redes">Redes</a></li>
        <li><a href="#parcerias">Parcerias</a></li>
      </ul>
      <button class="mobile-toggle" id="mobileToggle" aria-label="Abrir menu" aria-expanded="false">
        <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </nav>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    <a href="#missoes">Quem sou</a><a href="#galeria">Fotos</a><a href="#redes">Redes</a><a href="#parcerias">Parcerias</a>
    <a class="mm-cta js-wa" href="https://wa.me/5513981829135?text=Ol%C3%A1%21%20Vim%20pelo%20site%20do%20Neto%20Bonette%20e%20gostaria%20de%20falar%20sobre%20uma%20parceria.">Falar no WhatsApp</a>
  </div>

  <header class="hero" id="inicio">
    <div class="hero-field" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="portrait">
        <img src="data:image/jpeg;base64," alt="Ilustração do Neto Bonette vestido de coroinha">
        <span class="portrait-cross" aria-hidden="true"><svg viewBox="0 0 24 24" stroke-width="2.4" stroke-linecap="round"><path d="M12 3v18M6 9h12"/></svg></span>
      </div>
      <p class="hero-tag">Católico &amp; Coroinha</p>
      <h1 class="hero-title js-split">Neto Bonette</h1>
      <p class="hero-desc">Coroinha, criador de conteúdo digital e voluntário da Pastoral da Criança.</p>
      <div class="hero-actions">
        <a class="btn btn-main js-wa" href="https://wa.me/5513981829135?text=Ol%C3%A1%21%20Vim%20pelo%20site%20do%20Neto%20Bonette%20e%20gostaria%20de%20falar%20sobre%20uma%20parceria."><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>Propor uma parceria</a>
        <a class="btn btn-ghost" href="https://www.instagram.com/neto_bonette/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zm5.25-2.75a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"/></svg>Seguir no Instagram</a>
      </div>
    </div>
    <span class="scroll-cue" aria-hidden="true"></span>
  </header>

  <div class="marquee" aria-hidden="true"><div class="marquee-track" id="marquee" data-text="Católico|Coroinha|Criador de conteúdo|Voluntário da Pastoral da Criança|Parcerias abertas"></div></div>

  <section class="sec" id="missoes">
    <div class="container">
      <header class="reveal">
        <h2 class="sec-title">No altar, nas redes e na comunidade</h2>
      </header>
      <div class="missoes">
        <article class="missao reveal" style="--c:var(--red);--c2:var(--red)">
          <div class="missao-icon"><svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12c0 5-2.7 8-6 8S6 8 6 3z"/><path d="M12 11v7M8 21h8M10 18h4"/></svg></div>
          <h3>Coroinha</h3>
          <p>Serviço ao altar nas celebrações da Igreja.</p>
        </article>
        <article class="missao reveal" style="--i:1;--c:var(--yellow);--c2:var(--gold)">
          <div class="missao-icon"><svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M10.5 9.5v5l4-2.5z"/></svg></div>
          <h3>Criador de conteúdo</h3>
          <p>Conteúdo católico no Instagram, no TikTok e no YouTube.</p>
        </article>
        <article class="missao reveal" style="--i:2;--c:var(--blue);--c2:var(--blue)">
          <div class="missao-icon"><svg viewBox="0 0 24 24" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></div>
          <h3>Pastoral da Criança</h3>
          <p>Voluntário da Pastoral da Criança.</p>
        </article>
      </div>
    </div>
  </section>

